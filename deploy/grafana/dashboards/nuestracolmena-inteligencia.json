    {
      "id": 9,
      "type": "table",
      "title": "Observables repetidos (correlación)",
      "description": "Mismo tipo y valor visto en 2 o más alertas/casos distintos.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "nuestracolmena-pg"
      },
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 24,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "nuestracolmena-pg"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT \"dataType\" AS \"Tipo\", data AS \"Valor\", count(*) AS \"Veces\", count(DISTINCT \"alertId\") AS \"Alertas\", count(DISTINCT \"caseId\") AS \"Casos\", bool_or(ioc) AS \"IOC\", max(\"createdAt\") AS \"Última vez\" FROM \"Observable\" WHERE $__timeFilter(\"createdAt\") AND \"organisationId\" IN (SELECT id FROM \"Organisation\" WHERE name IN ($org)) GROUP BY 1, 2 HAVING count(DISTINCT \"alertId\") + count(DISTINCT \"caseId\") >= 2 ORDER BY 3 DESC, 7 DESC LIMIT 15"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "filterable": true,
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false,
          "reducer": [
            "sum"
          ],
          "fields": ""
        }
      }
    },
