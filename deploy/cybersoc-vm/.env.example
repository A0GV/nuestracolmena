# Secretos: usa valores aleatorios y no los subas a git (chmod 600 .env).
POSTGRES_PASSWORD=change-me
JWT_SECRET=change-me

# Red / web
CORS_ORIGIN=https://192.0.2.4:9443,https://192.0.2.104:9443
PUBLIC_URL=https://192.0.2.4:9443
# HTTPS en el puerto de TheHive. Certificado en ./certs/server.crt y server.key:
#   mkdir -p certs && cp ~/soc/strangebee/prod1-thehive/nginx/certs/server.* certs/
MYHIVE_WEB_PORT=9443

# Límite de subida de adjuntos (MB). nginx usa client_max_body_size 100M.
MAX_UPLOAD_MB=100

# Catálogo MITRE ATT&CK (vacío = repositorio oficial de MITRE CTI).
# MITRE_ATTACK_URL=https://raw.githubusercontent.com/mitre/cti/master/enterprise-attack/enterprise-attack.json

# Programadores en segundo plano. Ponlos a false para desactivarlos.
INTEGRATIONS_SCHEDULER=true
SLA_SCHEDULER=true
# Sondeo de buzones IMAP (ingesta de correo de reportes de phishing).
EMAIL_SCHEDULER=true

# Grafana (opcional, gráficas en https://192.0.2.4:9443/grafana/). Ver README, sección Grafana.
# COMPOSE_PROFILES=grafana
GRAFANA_ADMIN_PASSWORD=
MYHIVE_GRAFANA_DB_PASSWORD=
