          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT COALESCE(s.value, a.stage) AS \"Estado\", count(*) AS \"Alertas\" FROM \"Alert\" a LEFT JOIN \"AlertStatus\" s ON s.id = a.\"statusId\" WHERE $__timeFilter(a.date) AND a.\"organisationId\" IN (SELECT id FROM \"Organisation\" WHERE name IN ($org)) GROUP BY 1 ORDER BY 2 DESC"
