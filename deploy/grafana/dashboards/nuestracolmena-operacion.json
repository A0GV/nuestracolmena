    {
      "id": 4,
      "type": "stat",
      "title": "Alertas convertidas en caso",
      "description": "Porcentaje de las alertas del rango que se importaron a un caso.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "nuestracolmena-pg"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "nuestracolmena-pg"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT CASE WHEN count(*) = 0 THEN NULL ELSE 100.0 * count(*) FILTER (WHERE \"caseId\" IS NOT NULL) / count(*) END AS \"%\" FROM \"Alert\" WHERE $__timeFilter(date) AND \"organisationId\" IN (SELECT id FROM \"Organisation\" WHERE name IN ($org))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "color": {
            "mode": "fixed",
            "fixedColor": "purple"
          },
          "noValue": "—",
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
