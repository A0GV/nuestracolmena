    {
      "id": 5,
      "type": "stat",
      "title": "Alerta → caso (mediana)",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "nuestracolmena-pg"
      },
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 4,
        "h": 4
