    {
      "id": 9,
      "type": "table",
      "title": "Tareas vencidas",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "nuestracolmena-pg"
      },
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "nuestracolmena-pg"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT c.number AS \"Caso\", c.title AS \"Título del caso\", t.title AS \"Tarea\", t.status AS \"Estado\", COALESCE(u.name, 'Sin asignar') AS \"Asignado\", t.\"dueDate\" AS \"Vencimiento\" FROM \"CaseTask\" t JOIN \"Case\" c ON c.id = t.\"caseId\" LEFT JOIN grafana_user u ON u.id = t.\"assigneeId\" WHERE t.\"dueDate\" < now() AT TIME ZONE 'UTC' AND t.status NOT IN ('Completed','Cancel') AND t.\"organisationId\" IN (SELECT id FROM \"Organisation\" WHERE name IN ($org)) ORDER BY t.\"dueDate\" LIMIT 100"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "filterable": true,
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Caso"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Abrir caso",
                    "url": "/grafana/../cases/${__value.raw}",
                    "targetBlank": true
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false,
          "reducer": [
            "sum"
          ],
          "fields": ""
        }
      }
    },
