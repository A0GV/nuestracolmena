            "type": "grafana-postgresql-datasource",
            "uid": "nuestracolmena-pg"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT $__timeGroupAlias(date, $__interval, 0), CASE severity WHEN 1 THEN 'Baja' WHEN 2 THEN 'Media' WHEN 3 THEN 'Alta' WHEN 4 THEN 'Crítica' ELSE 'Otra' END AS metric, count(*) AS value FROM \"Alert\" WHERE $__timeFilter(date) AND \"organisationId\" IN (SELECT id FROM \"Organisation\" WHERE name IN ($org)) GROUP BY 1, 2 ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "lineWidth": 1,
            "showPoints": "never",
            "stacking": {
