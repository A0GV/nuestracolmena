            "uid": "nuestracolmena-pg"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT avg(extract(epoch FROM (\"closedAt\" - \"startDate\")))::float AS \"Resolución\" FROM \"Case\" WHERE \"closedAt\" IS NOT NULL AND $__timeFilter(\"closedAt\") AND \"organisationId\" IN (SELECT id FROM \"Organisation\" WHERE name IN ($org))"
