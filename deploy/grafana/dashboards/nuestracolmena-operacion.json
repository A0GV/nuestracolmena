      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "nuestracolmena-pg"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT percentile_cont(0.5) WITHIN GROUP (ORDER BY extract(epoch FROM (c.\"createdAt\" - a.date))) FROM \"Alert\" a JOIN \"Case\" c ON c.id = a.\"caseId\" WHERE c.\"createdAt\" >= a.date AND $__timeFilter(a.date) AND a.\"organisationId\" IN (SELECT id FROM \"Organisation\" WHERE name IN ($org))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
