              "group": "A"
            },
            "spanNulls": false,
            "barAlignment": 0
          },
          "min": 0,
          "decimals": 0,
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Baja"
            },
            "properties": [
